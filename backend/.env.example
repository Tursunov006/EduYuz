PORT=3000
NODE_ENV=development

# Database URL (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/edyuz_db"

# JWT Configuration
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="7d"

# Telegram Bot Token & WebApp
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBAPP_URL="https://your-domain.com"

# Eskiz.uz SMS Gateway
ESKIZ_EMAIL="info@eduyuz.uz"
ESKIZ_PASSWORD="secret_password"
ESKIZ_FROM="4546"
