PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduyuz?schema=public"

# JWT: kamida 32 belgili tasodifiy qiymat qo'ying. Yaratish: openssl rand -hex 32
# Bo'sh qoldirilsa server har ishga tushganda yangi tasodifiy kalit yaratadi
# (barcha foydalanuvchilar qayta login qilishi kerak bo'ladi).
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Ruxsat etilgan frontend manzillari (vergul bilan). Bo'sh bo'lsa — hammasi.
CORS_ORIGINS="http://localhost:3001"

# Telegram bot (@BotFather). Token HECH QACHON kodga yozilmasin.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBAPP_URL="http://localhost:3001"
# Bot webhook manzili (ixtiyoriy). Render'da bo'sh qoldiring: RENDER_EXTERNAL_URL dan avtomatik olinadi.
# Berilmasa va Render ham bo'lmasa, bot polling (getUpdates) rejimida ishlaydi.
TELEGRAM_WEBHOOK_URL=""
WEB_APP_URL="http://localhost:3001"

# Eskiz.uz SMS
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# AI
GEMINI_API_KEY=""

# Click to'lov tizimi. CLICK_SECRET_KEY bo'sh bo'lsa webhook'lar rad etiladi.
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# Atmos to'lov tizimi. ATMOS_API_KEY bo'sh bo'lsa callback rad etiladi.
ATMOS_STORE_ID=""
ATMOS_CONSUMER_KEY=""
ATMOS_CONSUMER_SECRET=""
ATMOS_API_KEY=""

# Instagram / Meta webhook
INSTAGRAM_VERIFY_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""

# Dastlabki ma'lumotlar (npx ts-node prisma/seed.ts) uchun parollar.
# Bo'sh qoldirilsa tasodifiy parol yaratilib, konsolga bir marta chiqariladi.
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""
