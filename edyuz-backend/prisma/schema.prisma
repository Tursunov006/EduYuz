datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  superadmin
  admin
  teacher
}

enum StudentStatus {
  active
  inactive
}

enum AttendanceStatus {
  present
  absent
  late
}

enum PaymentType {
  cash
  card
  click
  payme
}

enum ExpenseCategory {
  rent
  salary
  utilities
  marketing
  equipment
  stationery
  tax
  other
}

model Center {
  id        String    @id @default(uuid()) @db.VarChar(36)
  name      String    @db.VarChar(150)
  phone     String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")

  users     User[]
  courses   Course[]
  groups    Group[]
  students  Student[]
  expenses  Expense[]

  @@map("centers")
}

model User {
  id           String    @id @default(uuid()) @db.VarChar(36)
  centerId     String    @map("center_id") @db.VarChar(36)
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         RoleType  @default(teacher)
  specialty    String?   @db.VarChar(100)
  salaryType   String    @default("percentage") @map("salary_type") @db.VarChar(20)
  salaryRate   Decimal   @default(50.0) @map("salary_rate") @db.Decimal(12, 2)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  center         Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groups         Group[]
  attendances    Attendance[]
  salaryPayments SalaryPayment[]

  @@index([centerId])
  @@map("users")
}

model Course {
  id        String   @id @default(uuid()) @db.VarChar(36)
  centerId  String   @map("center_id") @db.VarChar(36)
  title     String   @db.VarChar(100)
  price     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groups    Group[]

  @@map("courses")
}

model Group {
  id        String   @id @default(uuid()) @db.VarChar(36)
  centerId  String   @map("center_id") @db.VarChar(36)
  courseId  String   @map("course_id") @db.VarChar(36)
  teacherId String   @map("teacher_id") @db.VarChar(36)
  name      String   @db.VarChar(100)
  days      Json
  startTime String   @map("start_time") @db.VarChar(5) // HH:mm format
  endTime   String   @map("end_time") @db.VarChar(5)   // HH:mm format
  createdAt DateTime @default(now()) @map("created_at")

  center      Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher     User           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students    GroupStudent[]
  attendances Attendance[]
  lessons     Lesson[]

  @@index([centerId])
  @@map("groups")
}

model Student {
  id           String        @id @default(uuid()) @db.VarChar(36)
  centerId     String        @map("center_id") @db.VarChar(36)
  fullName     String        @map("full_name") @db.VarChar(100)
  phone        String?       @db.VarChar(20)
  parentPhone  String        @map("parent_phone") @db.VarChar(20)
  parentChatId BigInt?       @map("parent_chat_id")
  balance          Decimal              @default(0) @db.Decimal(12, 2)
  coins            Int                  @default(0)
  points           Int                  @default(0)
  status           StudentStatus        @default(active)
  createdAt        DateTime             @default(now()) @map("created_at")

  center           Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groups           GroupStudent[]
  attendances      Attendance[]
  payments         Payment[]
  submissions      HomeworkSubmission[]
  certificates     Certificate[]
  coinTransactions CoinTransaction[]

  @@index([centerId])
  @@map("students")
}

model GroupStudent {
  groupId   String   @map("group_id") @db.VarChar(36)
  studentId String   @map("student_id") @db.VarChar(36)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Date

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@map("group_students")
}

model Attendance {
  id        String           @id @default(uuid()) @db.VarChar(36)
  groupId   String           @map("group_id") @db.VarChar(36)
  studentId String           @map("student_id") @db.VarChar(36)
  date      DateTime         @default(now()) @db.Date
  status    AttendanceStatus
  markedBy  String?          @map("marked_by") @db.VarChar(36)
  createdAt DateTime         @default(now()) @map("created_at")

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marker    User?            @relation(fields: [markedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, studentId, date])
  @@index([groupId, date])
  @@map("attendance")
}

model Payment {
  id            String      @id @default(uuid()) @db.VarChar(36)
  studentId     String      @map("student_id") @db.VarChar(36)
  amount        Decimal     @db.Decimal(12, 2)
  paymentMethod PaymentType @map("payment_method")
  paidAt        DateTime    @default(now()) @map("paid_at")
  comment       String?     @db.Text

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("payments")
}

enum SubmissionStatus {
  pending
  reviewed
  rejected
}

model Lesson {
  id         String     @id @default(uuid()) @db.VarChar(36)
  groupId    String     @map("group_id") @db.VarChar(36)
  title      String     @db.VarChar(150)
  content    String?    @db.Text
  videoUrl   String?    @map("video_url") @db.VarChar(255)
  fileUrl    String?    @map("file_url") @db.VarChar(255)
  orderIndex Int        @default(1) @map("order_index")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeworks  Homework[]

  @@index([groupId])
  @@map("lessons")
}

model Homework {
  id          String               @id @default(uuid()) @db.VarChar(36)
  lessonId    String               @map("lesson_id") @db.VarChar(36)
  title       String               @db.VarChar(150)
  description String               @db.Text
  deadline    DateTime?
  maxScore    Int                  @default(100) @map("max_score")
  createdAt   DateTime             @default(now()) @map("created_at")

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([lessonId])
  @@map("homeworks")
}

model HomeworkSubmission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  homeworkId  String           @map("homework_id") @db.VarChar(36)
  studentId   String           @map("student_id") @db.VarChar(36)
  content     String           @db.Text
  fileUrl     String?          @map("file_url") @db.VarChar(255)
  score       Int?
  feedback    String?          @db.Text
  status      SubmissionStatus @default(pending)
  submittedAt DateTime         @default(now()) @map("submitted_at")
  reviewedAt  DateTime?        @map("reviewed_at")

  homework    Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
  @@map("homework_submissions")
}

model CoinTransaction {
  id        String   @id @default(uuid()) @db.VarChar(36)
  studentId String   @map("student_id") @db.VarChar(36)
  amount    Int
  reason    String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("coin_transactions")
}

model Certificate {
  id                String   @id @default(uuid()) @db.VarChar(36)
  certificateNumber String   @unique @map("certificate_number") @db.VarChar(50)
  studentId         String   @map("student_id") @db.VarChar(36)
  courseTitle       String   @map("course_title") @db.VarChar(150)
  grade             String   @default("A+") @db.VarChar(10)
  issuedAt          DateTime @default(now()) @map("issued_at")

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certificates")
}

model SalaryPayment {
  id            String      @id @default(uuid()) @db.VarChar(36)
  teacherId     String      @map("teacher_id") @db.VarChar(36)
  amount        Decimal     @db.Decimal(12, 2)
  periodMonth   String      @map("period_month") @db.VarChar(20)
  paymentMethod PaymentType @default(cash) @map("payment_method")
  paidAt        DateTime    @default(now()) @map("paid_at")
  comment       String?     @db.Text

  teacher       User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("salary_payments")
}

model Expense {
  id            String          @id @default(uuid()) @db.VarChar(36)
  centerId      String          @map("center_id") @db.VarChar(36)
  title         String          @db.VarChar(150)
  amount        Decimal         @db.Decimal(12, 2)
  category      ExpenseCategory @default(other)
  paymentMethod PaymentType     @default(cash) @map("payment_method")
  paidAt        DateTime        @default(now()) @map("paid_at")
  comment       String?         @db.Text

  center        Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([category])
  @@map("expenses")
}

model SmsLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  phone     String   @db.VarChar(20)
  message   String   @db.Text
  status    String   @default("sent") @db.VarChar(20)
  sentAt    DateTime @default(now()) @map("sent_at")

  @@map("sms_logs")
}
