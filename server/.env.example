# Bu faylni .env nomi bilan nusxalang:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env hech qachon GitHub'ga yuklanmaydi. Qiymatlarni Render → Environment'dan ko'chiring.

# Baza (Supabase). Render'dagi DATABASE_URL bilan bir xil.
DATABASE_URL=""
# Render'dagi qiymatlar bilan AYNAN bir xil bo'lishi shart (aks holda login va shifrlangan ma'lumotlar ishlamaydi)
JWT_SECRET=""
ENCRYPTION_KEY=""
TELEGRAM_BOT_TOKEN=""

# Backendning internetdagi manzili (Cloudflare Tunnel'da ochilgan), masalan https://api.eduyuz.uz
# Telegram webhook shu manzilga o'rnatiladi.
TELEGRAM_WEBHOOK_URL="https://api.eduyuz.uz/api/v1/telegram/webhook"
WEB_APP_URL="https://www.eduyuz.uz"
TELEGRAM_WEBAPP_URL="https://www.eduyuz.uz"

# Cloudflare Zero Trust → Networks → Tunnels → tunnel yaratgandan keyin beriladigan token
CLOUDFLARE_TUNNEL_TOKEN=""

# Ixtiyoriy (Render'da bo'lsa shu yerga ham ko'chiring)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
GEMINI_API_KEY=""
